{
  "name": "todo-floating-search",
  "version": "1.0.0",
  "description": "妗岄潰鎮诞寰呭姙娓呭崟涓庢枃浠舵悳绱㈠伐鍏?,
  "main": "main.js",
  "author": "TodoSearch",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "npm run icon && electron-builder --dir",
    "dist": "npm run icon && electron-builder",
    "dist:win": "npm run icon && electron-builder --win",
    "icon": "node scripts/generate-icon.js"
  },
  "build": {
    "appId": "com.todosearch.app",
    "productName": "TodoSearch",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "renderer.js",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "portable", "artifactName": "${productName}-${version}-${arch}-portable.${ext}" },
        { "target": "nsis", "artifactName": "${productName}-${version}-${arch}-Setup.${ext}" }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1"
  }
}
